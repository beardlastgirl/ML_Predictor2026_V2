{
  "experimental": {
    "enableAgents": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .gemini/hooks/gsd-check-update.js"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook gemini-cli sessionstart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .gemini/hooks/gsd-context-monitor.js"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook gemini-cli posttooluse"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "context-mode hook gemini-cli beforetool"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .gemini/hooks/gsd-statusline.js"
  },
  "mcpServers": {
    "context-mode": {
      "command": "context-mode"
    },
    "colab-mcp": {
      "command": "uvx",
      "args": ["git+https://github.com/googlecolab/colab-mcp"],
      "timeout": 30000
    },
    "playwright": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-playwright@latest"],
      "description": "Playwright browser automation MCP server for web scraping, testing, and debugging"
    },
    "python": {
      "command": "python",
      "args": ["-m", "mcp.server.python"],
      "description": "Python MCP server for code analysis, refactoring, and Python execution"
    },
	"roundtable": {
	  "type": "http",
	  "url": "https://mcp.roundtable.now/mcp"
	}
  }
}
