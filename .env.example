# ML_Predictor2026_V2 Environment Configuration
# Copy this file to .env and fill in your values

# Apify API Token (required for Sofascore scraper)
# Get your token from https://console.apify.com
# NOTE: never commit a real token; this file is a template only
APIFY_API_TOKEN=your_apify_token_here

# API-Football Key (required for xG enrichment: DataIngestor.enrich_with_api_stats)
# Get your key from https://www.api-football.com
API_FOOTBALL_KEY=your_api_football_key_here

# Model Selection (optional)
# Options: catboost, lightgbm
# Default: catboost
ML_PREDICTOR_MODEL=catboost
