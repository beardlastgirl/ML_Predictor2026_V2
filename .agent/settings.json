{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agent/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .agent/hooks/gsd-context-monitor.js"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-playwright@latest"],
      "description": "Playwright browser automation MCP server for web scraping, testing, and debugging"
    },
    "python": {
      "command": "python",
      "args": ["-m", "mcp.server.python"],
      "description": "Python MCP server for code analysis, refactoring, and Python execution"
    },
    "colab-mcp": {
      "command": "uvx",
      "args": ["git+https://github.com/googlecolab/colab-mcp"],
      "timeout": 30000,
      "description": "Google Colab integration for collaborative development"
    },
    "roundtable": {
      "type": "http",
      "url": "https://mcp.roundtable.now/mcp",
      "description": "Real-time collaboration platform for AI agents"
    }
  }
}
