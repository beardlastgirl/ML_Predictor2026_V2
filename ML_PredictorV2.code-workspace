{
  "name": "ML Predictor 2026 V2",
  "displayName": "Football Match Prediction System",
  "description": "Machine learning pipeline for predicting football match outcomes using Poisson distribution and advanced ML techniques",
  "version": "2.0.0",
  "publisher": "Personal Project",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ML_Predictor2026_V2.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Data Science", "Machine Learning", "Web Scraping"],
  "keywords": ["football", "prediction", "machine-learning", "poisson", "catboost", "scraping", "argentina"],
  "main": "./main.py",
  "folders": [
    {
      "name": "ML Predictor 2026 V2",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "./.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.formatting.provider": "black",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestPath": "./.venv/Scripts/pytest.exe",
    "python.testing.pytestArgs": ["tests"],
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      ".venv/**": true,
      "**/node_modules": true
    },
    "files.associations": {
      "*.json": "jsonc",
      "*.txt": "plaintext"
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "terminal.integrated.env.windows": {
      "PYTHONPATH": "${workspaceFolder}",
      "PYTHONUNBUFFERED": "1"
    },
    "jupyter.askForKernelRestart": false,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "none"
    },
    "cursorpyright.analysis.autoImportCompletions": true,
    "cursorpyright.analysis.diagnosticSeverityOverrides": {
      "reportMissingImports": "none"
    },
    "cursorpyright.analysis.typeCheckingMode": "basic"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.black-formatter",
      "ms-python.flake8",
      "ms-python.pylint",
      "ms-python.isort",
      "ms-python.debugpy",
      "ms-toolsai.jupyter",
      "ms-vscode.powershell",
      "redhat.vscode-yaml",
      "ms-vscode.vscode-json",
      "github.vscode-pull-request-github",
      "ms-vscode.test-adapter-converter",
      "hbenl.vscode-test-explorer"
    ],
    "unwantedRecommendations": ["ms-python.autopep8"]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run Main Prediction Model",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "args": []
      },
      {
        "name": "Scrape FBref Stats (Enhanced)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scrape_stats_enhanced.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Scrape FBref Stats (Manual)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scrape_stats_manual.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Scrape TyC Sports Fixtures",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scrape_tyc.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Parse PDF Reports",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/parse_reporte_pdfs.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Scrape Sofascore (Apify)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/scrape_sofascore_apify.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Convert Results Format",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/convert_results.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Run PowerShell Wrapper",
        "type": "PowerShell",
        "request": "launch",
        "script": "${workspaceFolder}/run_model.ps1",
        "cwd": "${workspaceFolder}",
        "args": []
      },
      {
        "name": "Debug Tests",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/.venv/Scripts/pytest.exe",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        },
        "args": ["tests", "-v"]
      },
      {
        "name": "Jupyter: Explore Data",
        "type": "debugpy",
        "request": "launch",
        "module": "jupyter",
        "args": ["notebook"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      {
        "name": "Debug Feature Importance",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/main.py",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONPATH": "${workspaceFolder}",
          "DEBUG_FEATURES": "1"
        },
        "args": ["--debug", "--feature-importance"]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Setup Virtual Environment",
        "type": "shell",
        "command": "python",
        "args": ["-m", "venv", ".venv"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Install Dependencies",
        "type": "shell",
        "command": ".venv/Scripts/pip.exe",
        "args": ["install", "-r", "requirements.txt"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Run Main Model",
        "type": "shell",
        "command": ".venv/Scripts/python.exe",
        "args": ["main.py"],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Run All Tests",
        "type": "shell",
        "command": ".venv/Scripts/pytest.exe",
        "args": ["tests", "-v"],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Scrape All Data",
        "type": "shell",
        "command": "powershell.exe",
        "args": ["-File", "run_model.ps1", "-Option", "6"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Convert Results",
        "type": "shell",
        "command": ".venv/Scripts/python.exe",
        "args": ["convert_results.py"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Quick Prediction Run",
        "type": "shell",
        "command": "powershell.exe",
        "args": ["-Command", "& { .venv/Scripts/python.exe main.py; .venv/Scripts/python.exe convert_results.py }"],
        "group": "test",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      },
      {
        "label": "Clean Cache & Temp Files",
        "type": "shell",
        "command": "powershell.exe",
        "args": ["-Command", "Remove-Item -Recurse -Force __pycache__, *.pyc, .pytest_cache -ErrorAction SilentlyContinue"],
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "shared"
        },
        "problemMatcher": []
      }
    ]
  }
}
